.nox/

# Database files
*.db
*.sqlite
*.sqlite3
data/analytics.db

# Large runtime data (keep directory structure with .gitkeep)
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep

