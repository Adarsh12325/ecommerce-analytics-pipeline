# ==============================================================================
# Environment Configuration for E-Commerce Batch ETL Pipeline
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack:
#   cp .env.example .env
# ==============================================================================

# Airflow Core User & Group ID (on Linux/macOS, run `id -u` to find your UID)
# Default 50000 matches the default non-root user in apache/airflow images
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Airflow Project & Base Directory Settings
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow Webserver Secret Key (Generate with: openssl rand -hex 30)
AIRFLOW__WEBSERVER__SECRET_KEY=462e0861a98cd65178c7d6184b8da536

# Airflow Core Settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/

# PostgreSQL Metadata Database Credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Data Pipeline Paths (Container Paths)
DATA_SOURCE_URL=https://raw.githubusercontent.com/databricks/Spark-The-Definitive-Guide/master/data/retail-data/all/online-retail-dataset.csv
RAW_DATA_PATH=/opt/airflow/data/raw/ecommerce_data.csv
BRONZE_DATA_PATH=/opt/airflow/data/bronze
SILVER_DATA_PATH=/opt/airflow/data/silver
ANALYTICS_DB_PATH=/opt/airflow/data/analytics.db
GREAT_EXPECTATIONS_DIR=/opt/airflow/great_expectations
